# Copy to .env.local for local dev (and .dev.vars for `npm run preview`). Never commit real values.
# On Cloudflare: NEXT_PUBLIC_* must be set at build time AND as Worker vars; secrets via `npx wrangler secret put NAME`.
# NEXT_PUBLIC_* values are sent to the browser; everything else is server-only.

# --- Supabase (Project settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server/cron only (bypasses RLS). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Domain whose mail Cloudflare Email Routing sends to the worker, e.g. in.jobswitcher.app
NEXT_PUBLIC_INBOUND_EMAIL_DOMAIN=in.example.com
# Shared HMAC secret between the Cloudflare Email Worker and /api/inbound/email (openssl rand -hex 32)
INBOUND_SHARED_SECRET=
# Bearer token for the optional HTTP cron endpoint /api/cron/reminders (openssl rand -hex 32)
CRON_SECRET=

# --- AI (server-only). Without a key the app runs in template mode (no AI calls). ---
# anthropic | gemini
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# extraction, normalisation, tailoring
AI_MODEL_FAST=claude-haiku-5-5
# Master CV, cover letter
AI_MODEL_QUALITY=claude-sonnet-5-5
# Optional Gemini alternative (called over the REST API)
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_QUALITY=gemini-2.5-pro

# --- Transactional email for reminders (pick one) ---
# resend | brevo
EMAIL_PROVIDER=resend
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM="Job Switcher <reminders@your-domain.com>"

# --- Admin (owner-only pages such as /admin/payments). Comma-separated sign-in emails. ---
ADMIN_EMAILS=

# --- bKash payments for Pro (৳199 / 30 days). Leave empty to keep payments closed. ---
# manual, checkout, or both (each path also needs its own variables below)
PAYMENT_METHODS=manual,checkout
# Manual path: your bKash number and its type: personal (Send Money) | merchant (Payment) | agent
BKASH_MANUAL_NUMBER=
BKASH_MANUAL_ACCOUNT_TYPE=personal
# Tokenized Checkout (merchant accounts). Base URL defaults to the sandbox:
# https://tokenized.sandbox.bka.sh/v1.2.0-beta   (production: the live URL from bKash)
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Card payments outside Bangladesh through Paddle (off until all four are set). PADDLE_ENV=sandbox for sandbox keys.
PADDLE_API_KEY=
PADDLE_PRODUCT_ID=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_ENV=
